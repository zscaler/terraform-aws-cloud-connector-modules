# -----------------------------------------------------------------------------
# examples/aws-end-to-end — outputs
# -----------------------------------------------------------------------------

output "gateway_id" {
  description = "The cloud-assigned ZTGW Gateway ID."
  value       = var.deploy_ztgw ? module.ztgw_gateway[0].gateway_id : null
}

output "gateway_name" {
  description = "The name of the provisioned ZTGW."
  value       = var.deploy_ztgw ? module.ztgw_gateway[0].gateway_name : var.gateway_name
}

output "gateway_health_status" {
  description = "Health status of the provisioned ZTGW."
  value       = var.deploy_ztgw ? module.ztgw_gateway[0].health_status : null
}

output "endpoint_service_name" {
  description = "The AWS VPC Endpoint Service name generated by Zscaler."
  value       = local.endpoint_service_name
}

output "vpc_endpoint_id" {
  description = "The ID of the customer-side Gateway Load Balancer VPC Endpoint."
  value       = var.deploy_consumer ? module.gwlb_consumer[0].endpoint_id : null
}

output "vpc_endpoint_arn" {
  description = "The ARN of the customer-side Gateway Load Balancer VPC Endpoint."
  value       = var.deploy_consumer ? module.gwlb_consumer[0].endpoint_arn : null
}

output "route_ids" {
  description = "Map of customer route table IDs to created routes pointing to ZTGW."
  value       = var.deploy_consumer ? module.gwlb_consumer[0].route_ids : null
}
