def prompt_input(prompt: str, default: str = None, secret: bool = False) -> str:
    default_hint = f" [{CYAN}{default}{RESET}]" if default else ""
    full_prompt = f"{BOLD}{prompt}{RESET}{default_hint}: "
    if secret:
        val = getpass.getpass(full_prompt).strip()
    else:
        val = input(full_prompt).strip()
    return val if val else (default if default else "")


def build_ssl_context(insecure: bool = False) -> ssl.SSLContext:
    if insecure or os.environ.get("INSECURE_SKIP_VERIFY", "").lower() in ("true", "1", "yes"):
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        return ctx

    ctx = ssl.create_default_context()

    # 1. Try certifi if installed in Python environment
    try:
        import certifi
        ctx.load_verify_locations(cafile=certifi.where())
        return ctx
    except (ImportError, Exception):
        pass

    # 2. Check standard cross-platform and Linux/Unix CA trust stores
    ca_candidates = [
        # Explicit user/system environment overrides
        os.environ.get("SSL_CERT_FILE"),
        os.environ.get("REQUESTS_CA_BUNDLE"),
        os.environ.get("CURL_CA_BUNDLE"),
        # Debian / Ubuntu / Alpine / Arch / Gentoo / Google Cloud Shell
        "/etc/ssl/certs/ca-certificates.crt",
        # RedHat / CentOS / Rocky / Alma / Amazon Linux / Fedora
        "/etc/pki/tls/certs/ca-bundle.crt",
        "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
        # openSUSE / SLES
        "/etc/ssl/ca-bundle.pem",
        # FreeBSD / OpenBSD / NetBSD
        "/usr/local/share/certs/ca-root-nss.crt",
        "/etc/ssl/cert.pem",
        # macOS Homebrew (Intel & Apple Silicon)
        "/opt/homebrew/etc/ca-certificates/cert.pem",
        "/usr/local/etc/ca-certificates/cert.pem",
        "/usr/local/etc/openssl/cert.pem",
    ]
    for ca_path in ca_candidates:
        if ca_path and os.path.isfile(ca_path):
            try:
                ctx.load_verify_locations(cafile=ca_path)
                return ctx
            except Exception:
                pass
    return ctx


def validate_oneapi_credentials(vanity: str, cloud: str, client_id: str, client_secret: str, login_domain_override: str = "") -> tuple:
    print(f"\n{CYAN}--> Pre-flight check: Validating Zscaler OneAPI credentials...{RESET}")
    cloud = cloud.lower()
    login_domain_map = {
        "zscalerbeta": "zsloginbeta.net",
        "zscalerthree": "zsloginthree.net",
        "zscalerone": "zsloginone.net",
        "zscalertwo": "zslogintwo.net",
    }
    login_domain = login_domain_override or login_domain_map.get(cloud, "zslogin.net")
    token_url = f"https://{vanity}.{login_domain}/oauth2/v1/token"

    data = urllib.parse.urlencode({
        "grant_type": "client_credentials",
        "client_id": client_id,
        "client_secret": client_secret,
    }).encode("utf-8")

    req = urllib.request.Request(token_url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded"}, method="POST")

    # 1. Try standard SSL verification
    ctx = build_ssl_context(insecure=False)
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=15) as resp:
            body = json.loads(resp.read().decode("utf-8"))
            if "access_token" in body:
                print(f"{GREEN}✓ Authentication successful with Zscaler OneAPI!{RESET}\n")
                return True, False
    except Exception as e:
        err_str = str(e)
        if "CERTIFICATE_VERIFY_FAILED" in err_str or "certificate verify failed" in err_str:
            print(f"{YELLOW}⚠ Standard SSL verify failed (corporate TLS inspection / ZCC detected). Retrying in proxy mode...{RESET}")
            insecure_ctx = build_ssl_context(insecure=True)
            try:
                with urllib.request.urlopen(req, context=insecure_ctx, timeout=15) as resp:
                    body = json.loads(resp.read().decode("utf-8"))
                    if "access_token" in body:
                        print(f"{GREEN}✓ Authentication successful (corporate proxy mode: insecure_skip_verify = true enabled){RESET}\n")
                        return True, True
            except Exception as e2:
                print(f"{RED}✗ Pre-flight validation failed: {e2}{RESET}\n")
                return False, False
        else:
            print(f"{RED}✗ Pre-flight validation failed: {e}{RESET}")
            print(f"{YELLOW}Please double-check your Client ID, Secret, and Vanity domain.{RESET}\n")
            return False, False
    return False, False


