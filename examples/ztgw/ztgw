        if supported_ztgw_azs:
            print(f"\n{CYAN}--> In this AWS account, Zscaler ZTGW in {region} operates in Availability Zones: {BOLD}{', '.join(supported_ztgw_azs)}{RESET}")

        discovered_subnets = discover_aws_subnets(vpc_id, region, profile=aws_profile)
        selected_subnets = []
        if discovered_subnets:
            compatible_subnets = [s for s in discovered_subnets if not supported_ztgw_azs or s.get("AZ") in supported_ztgw_azs]
            unsupported_subnets = [s for s in discovered_subnets if supported_ztgw_azs and s.get("AZ") not in supported_ztgw_azs]

            if compatible_subnets:
                print(f"\n{CYAN}Subnets compatible to host the ZTGW Endpoint (in {', '.join(supported_ztgw_azs)}):{RESET}")
                for idx, sub in enumerate(compatible_subnets, 1):
                    s_name = f" — {sub['Name']}" if sub.get("Name") else ""
                    s_az = sub.get("AZ", "")
                    s_cidr = f", CIDR: {sub.get('Cidr')}" if sub.get("Cidr") else ""
                    print(f"  [{idx}] {sub['Id']}{s_name} (AZ: {s_az}{s_cidr}) {GREEN}[Compatible]{RESET}")

            if unsupported_subnets:
                print(f"\n{YELLOW}ℹ NOTE: Subnets in other zones cannot host the endpoint interface because Zscaler has no physical dataplane in those AZs:{RESET}")
                for sub in unsupported_subnets:
                    s_name = f" — {sub['Name']}" if sub.get("Name") else ""
                    print(f"    • {sub['Id']}{s_name} (AZ: {sub.get('AZ')})")
                print(f"  Workloads in those zones will automatically route their outbound traffic across the VPC to this endpoint.\n")

            sub_default = "1,2" if len(compatible_subnets) >= 2 else "1"

            while True:
                sub_choice = prompt_input("Select subnet number(s) to host the GWLB endpoint (comma-separated, min 1 per AZ)", default=sub_default)
                selected_subnets = []
                incompatible_err = []
                for part in sub_choice.split(","):
                    part = part.strip()
                    matched = None
                    try:
                        matched = compatible_subnets[int(part) - 1]
                    except Exception:
                        for s in discovered_subnets:
                            if s["Id"] == part or s.get("Name") == part:
                                matched = s
                                break
                    if matched:
                        if supported_ztgw_azs and matched.get("AZ") not in supported_ztgw_azs:
                            incompatible_err.append(f"{matched['Id']} ({matched.get('AZ')})")
                        else:
                            selected_subnets.append(matched["Id"])
                    elif part:
                        selected_subnets.append(part)

                if incompatible_err:
                    print(f"\n{RED}✗ Incompatible subnet selected:{RESET} {', '.join(incompatible_err)}")
                    print(f"  Zscaler ZTGW in {region} only supports Availability Zones: {BOLD}{', '.join(supported_ztgw_azs)}{RESET} in this account.")
                    print(f"  AWS will reject GWLB endpoint creation in other AZs. Please select only compatible subnets.\n")
                    continue
                break

            # Validate AZ uniqueness for GWLB endpoint
            az_map = {}
            for s_id in selected_subnets:
                for s_obj in discovered_subnets:
                    if s_obj["Id"] == s_id and s_obj.get("AZ"):
                        az = s_obj["AZ"]
                        if az in az_map:
                            print(f"{YELLOW}⚠ Warning: Subnets '{az_map[az]}' and '{s_id}' are both in Availability Zone '{az}'.{RESET}")
                            print(f"  AWS Gateway Load Balancer Endpoints require at most 1 subnet per AZ.")
                        else:
                            az_map[az] = s_id
                        break

            subnets_str = json.dumps(selected_subnets)
        else:
            print(f"{YELLOW}ℹ Subnet discovery unavailable. Defaulting to manual input.{RESET}")
            subnets_str = prompt_input("Endpoint Subnet IDs (JSON list, minimum 1 per AZ)", default='["subnet-0aaa...", "subnet-0bbb..."]')

        # 3. Discover Route Tables with Name tags and Main association
        discovered_rts = discover_aws_route_tables(vpc_id, region, profile=aws_profile)
        if discovered_rts:
            print(f"\n{CYAN}Discovered Route Tables in {vpc_id}:{RESET}")
            for idx, rt in enumerate(discovered_rts, 1):
                rt_name = f" — {rt['Name']}" if rt.get("Name") else (" [Main VPC Route Table]" if rt.get("Main") else "")
                warn_rt = ""
                if rt.get("DefaultRouteTarget"):
                    warn_rt = f" {YELLOW}(Has existing 0.0.0.0/0 route -> {rt['DefaultRouteTarget']}){RESET}"
                print(f"  [{idx}] {rt['Id']}{rt_name}{warn_rt}")

            rt_choice = prompt_input("Select route table number(s) to steer to ZTGW (comma-separated)", default="1")
            selected_rts = []
            for part in rt_choice.split(","):
                part = part.strip()
                try:
                    selected_rts.append(discovered_rts[int(part) - 1]["Id"])
                except Exception:
                    for rt in discovered_rts:
                        if rt["Id"] == part or rt.get("Name") == part:
                            selected_rts.append(rt["Id"])
                            break
                    else:
                        if part:
                            selected_rts.append(part)

            overwrite_confirmed = True
            for r_id in selected_rts:
                for rt in discovered_rts:
                    if rt["Id"] == r_id and rt.get("DefaultRouteTarget"):
                        target = rt["DefaultRouteTarget"]
                        print(f"\n{YELLOW}⚠ Notice: Route table '{r_id}' already has a 0.0.0.0/0 route pointing to '{target}'.{RESET}")
                        ans = prompt_input(f"Overwrite/replace the existing 0.0.0.0/0 route in '{r_id}' to steer traffic through ZTGW? (y/n)", default="y")
                        if ans.lower() not in ("y", "yes"):
                            overwrite_confirmed = False
                            print(f"{YELLOW}Skipping route overwrite. Note: AWS will reject duplicate default routes unless replaced.{RESET}")

            route_table_ids_json = json.dumps(selected_rts)
        else:
            print(f"{YELLOW}ℹ Route table discovery unavailable. Defaulting to manual input.{RESET}")
            rt_input = prompt_input("Workload Route Table ID to steer to ZTGW (e.g. rtb-0123456789abcdef0)")
            route_table_ids_json = json.dumps([rt_input] if rt_input else [])
            overwrite_confirmed = True

    content = f"""# Auto-generated by ./ztgw configure for AWS (Mode: {deploy_mode}, Topology: {topo_choice})
aws_region              = "{region}"
customer_aws_account_id = "{account_id}"
deploy_ztgw             = {"true" if deploy_ztgw else "false"}
deploy_consumer         = {"true" if deploy_consumer else "false"}
"""
    if not deploy_ztgw:
        content += f'endpoint_service_name = "{existing_ep}"\n'

    if deploy_consumer:
        content += f"""customer_vpc_id         = "{vpc_id}"
endpoint_subnet_ids     = {subnets_str}
workload_route_table_ids = {route_table_ids_json}
overwrite_existing_routes = {"true" if overwrite_confirmed else "false"}
"""

    # Set physical Availability Zones for ZTGW deployment (minimum 2 physical zones for HA)
    all_azs = discover_aws_region_azs(region, profile=aws_profile)
    target_azs = []
    for a in all_azs:
        zid = a.get("ZoneId", "").lower()
        if zid.endswith("-az1") or zid.endswith("-az2"):
            if zid not in target_azs:
                target_azs.append(zid)
    if len(target_azs) < 2 and all_azs:
        for a in all_azs:
            zid = a.get("ZoneId", "").lower()
            if zid not in target_azs:
                target_azs.append(zid)
            if len(target_azs) >= 2:
                break
    if len(target_azs) < 2:
        target_azs = ["use1-az1", "use1-az2"]

    azs_formatted = "[\n  " + ",\n  ".join([f'"{z}"' for z in target_azs]) + "\n]"

    if deploy_ztgw:
        content += f"""
client_id     = "{client_id}"
client_secret = "{client_secret}"
vanity_domain = "{vanity}"
cloud         = "{cloud}"

gateway_name  = "{gateway_name}"
location_name = "Unified-AWS-{region}"
insecure_skip_verify = {"true" if insecure_skip_verify else "false"}

availability_zones = {azs_formatted}
"""
    with open(tfvars_file, "w") as f:
        f.write(content)
    os.chmod(tfvars_file, 0o600)

    cache_data = {
        "cloud_platform": "aws",
        "topology": topo_choice,
        "deploy_mode": deploy_mode,
        "aws_profile": aws_profile,
    }
    if access_key and secret_key:
        cache_data["aws_access_key_id"] = access_key
        cache_data["aws_secret_access_key"] = secret_key
        if session_token:
            cache_data["aws_session_token"] = session_token

    with open(CONFIG_CACHE, "w") as f:
        json.dump(cache_data, f)
    os.chmod(CONFIG_CACHE, 0o600)

    print(f"\n{GREEN}✓ Generated secure configuration for AWS:{RESET} {tfvars_file}")


