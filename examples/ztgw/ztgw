def get_cloud_urls(cloud: str, vanity: str, login_domain_override: str = "") -> tuple:
    cloud = cloud.lower()
    login_domain_map = {
        "zscalerbeta": "zsloginbeta.net",
        "zscalerthree": "zsloginthree.net",
        "zscalerone": "zsloginone.net",
        "zscalertwo": "zslogintwo.net",
    }
    login_domain = login_domain_override or login_domain_map.get(cloud, "zslogin.net")
    token_url = f"https://{vanity}.{login_domain}/oauth2/v1/token"
    base_url = f"https://connector.{cloud}.net/api/v1"
    return token_url, base_url


def fetch_oneapi_token(vanity: str, cloud: str, client_id: str, client_secret: str, insecure: bool = True) -> str:
    token_url, _ = get_cloud_urls(cloud, vanity)
    data = urllib.parse.urlencode({
        "grant_type": "client_credentials",
        "client_id": client_id,
        "client_secret": client_secret,
    }).encode("utf-8")
    req = urllib.request.Request(token_url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded"}, method="POST")
    ctx = build_ssl_context(insecure=insecure)
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=15) as resp:
            body = json.loads(resp.read().decode("utf-8"))
            return body.get("access_token", "")
    except Exception:
        if not insecure:
            ctx_fb = build_ssl_context(insecure=True)
            try:
                with urllib.request.urlopen(req, context=ctx_fb, timeout=15) as resp:
                    body = json.loads(resp.read().decode("utf-8"))
                    return body.get("access_token", "")
            except Exception:
                pass
    return ""


def check_tenant_pending_activation(tfvars_file: str) -> bool:
    """Checks Zscaler tenant for pending edits and prompts user before apply.
    Returns True to proceed, False if user chose not to activate."""
    if not os.path.exists(tfvars_file):
        return True

    c_id, c_secret, vanity, cloud = "", "", "", "zscaler"
    try:
        with open(tfvars_file, "r") as f:
            for line in f:
                line = line.strip()
                if line.startswith("client_id") and "=" in line:
                    c_id = line.split("=", 1)[1].strip().strip('"')
                elif line.startswith("client_secret") and "=" in line:
                    c_secret = line.split("=", 1)[1].strip().strip('"')
                elif line.startswith("vanity_domain") and "=" in line:
                    vanity = line.split("=", 1)[1].strip().strip('"')
                elif line.startswith("cloud") and "=" in line:
                    cloud = line.split("=", 1)[1].strip().strip('"')
    except Exception:
        return True

    if not (c_id and c_secret and vanity):
        return True

    token_url, base_url = get_cloud_urls(cloud, vanity)
    token = fetch_oneapi_token(vanity, cloud, c_id, c_secret, insecure=True)
    if not token:
        return True

    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE

    try:
        req = urllib.request.Request(
            f"{base_url}/ecAdminActivateStatus",
            headers={"Authorization": f"Bearer {token}", "User-Agent": "Zscaler-ZTGW-CLI/2.0"}
        )
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if data.get("orgEditStatus") == "EDITS_PRESENT":
                admin_map = data.get("adminStatusMap", {})
                print("\n" + "=" * 70)
                print(f"{YELLOW}⚠ NOTICE: Pending unactivated draft changes detected in Zscaler tenant!{RESET}")
                if admin_map:
                    print("  Active administrator sessions with draft edits:")
                    for adm, st in admin_map.items():
                        print(f"    • {adm} ({st})")
                print("=" * 70)
                ans = prompt_input("Do you want to activate all pending tenant changes now? (y/n)", default="n")
                if ans.lower() in ("y", "yes"):
                    req_act = urllib.request.Request(
                        f"{base_url}/ecAdminActivateStatus/forcedActivate",
                        data=b"{}",
                        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "Zscaler-ZTGW-CLI/2.0"},
                        method="PUT"
                    )
                    try:
                        with urllib.request.urlopen(req_act, context=ctx, timeout=10):
                            print(f"{GREEN}✓ Cloud tenant changes activated successfully.{RESET}\n")
                            time.sleep(3)
                            return True
                    except Exception as e:
                        print(f"{YELLOW}Warning: Activation call failed: {e}{RESET}")
                        return True
                else:
                    print(f"\n{RED}Apply cancelled.{RESET} Please review and activate (or discard) pending changes in the Zscaler Admin Portal before proceeding.\n")
                    return False
    except Exception:
        pass
    return True


def run_terraform(action: str, target_cloud: str = ""):
    check_terraform_installed()
    banner()

    platform_name, active_dir = get_active_cloud_dir(interactive=True, target_arg=target_cloud)
    tfvars_file = os.path.join(active_dir, "terraform.tfvars")

    if not os.path.exists(tfvars_file) and action != "configure":
        print(f"\n{YELLOW}Warning: {tfvars_file} not found.{RESET}")
        print(f"Run {CYAN}./ztgw configure{RESET} first to set up {platform_name.upper()}.\n")
        sys.exit(1)

    print(f"\n{CYAN}Target Platform:{RESET} {BOLD}{platform_name.upper()}{RESET} ({active_dir})\n")

    # 1. Initialize if needed
    if not os.path.exists(os.path.join(active_dir, ".terraform")):
        print(f"--> Initializing Terraform modules and providers...")
        subprocess.run(["terraform", f"-chdir={active_dir}", "init"], check=True)

    # 2. Run action
    cmd = ["terraform", f"-chdir={active_dir}", action]
    if action == "apply":
        should_proceed = check_tenant_pending_activation(tfvars_file)
        if not should_proceed:
            sys.exit(0)
        cmd.append("-auto-approve")
    elif action == "destroy":
        print(f"{BOLD}Teardown Scope for {platform_name.upper()}:{RESET}")
        print("  [1] Full Teardown — Destroy cloud consumer VPC plumbing AND deprovision ZTGW in Zscaler")
        print("  [2] Consumer Only — Disconnect cloud VPC endpoints/routes (keep ZTGW active in Zscaler)")
        print("  [3] Cancel")
        scope = prompt_input("Enter selection (1, 2, or 3)", default="1")
        if scope in ("3", "c", "cancel"):
            print("Teardown cancelled.")
            sys.exit(0)
        elif scope == "2":
            consumer_module = "module.gwlb_consumer" if platform_name == "aws" else "module.nsi_consumer"
            print(f"\n{CYAN}--> Tearing down consumer plumbing only ({consumer_module})...{RESET}")
            cmd.extend(["-target", consumer_module, "-auto-approve"])
        else:
            confirm = input(f"\n{RED}{BOLD}Are you sure you want to completely destroy all {platform_name.upper()} ZTGW and cloud resources? (yes/no): {RESET}")
            if confirm.lower() not in ("yes", "y"):
                print("Teardown cancelled.")
                sys.exit(0)
            cmd.append("-auto-approve")

    env = os.environ.copy()
    # Force Go binaries (Terraform and AWS provider) to use OS resolver (cgo) instead of buggy/dead IPv6 DNS nameservers
    env["GODEBUG"] = "netdns=cgo"
    if os.path.exists(tfvars_file):
        try:
            with open(tfvars_file, "r") as f:
                if "insecure_skip_verify = true" in f.read().lower():
                    env["INSECURE_SKIP_VERIFY"] = "true"
        except Exception:
            pass

    if platform_name == "aws":
        if os.path.exists(CONFIG_CACHE):
            try:
                with open(CONFIG_CACHE) as f:
                    cdata = json.load(f)
                    if cdata.get("aws_access_key_id"):
                        env["AWS_ACCESS_KEY_ID"] = cdata["aws_access_key_id"]
                        env["AWS_SECRET_ACCESS_KEY"] = cdata["aws_secret_access_key"]
                        if cdata.get("aws_session_token"):
                            env["AWS_SESSION_TOKEN"] = cdata["aws_session_token"]
                    elif cdata.get("aws_profile") and "AWS_PROFILE" not in env and "AWS_ACCESS_KEY_ID" not in env:
                        env["AWS_PROFILE"] = cdata["aws_profile"]
            except Exception:
                pass

        # PREFLIGHT AUTH CHECK: Ensure AWS SSO session is active before launching Terraform
        if "AWS_ACCESS_KEY_ID" not in env:
            active_profile = env.get("AWS_PROFILE", "")
            if not active_profile and os.path.exists(CONFIG_CACHE):
                try:
                    with open(CONFIG_CACHE) as f:
                        active_profile = json.load(f).get("aws_profile", "")
                except Exception:
                    pass

            # Only verify profile SSO if a profile was explicitly configured.
            # If active_profile is empty, user relies on IAM Instance Profile, EKS IRSA, or cloud identity.
            if active_profile:
                if not check_and_login_aws_profile(active_profile):
                    print(f"\n{RED}✗ Authentication Error: Cannot proceed with expired AWS SSO session for profile '{active_profile}'.{RESET}", flush=True)
                    print(f"  Please run: {CYAN}aws sso login --profile {active_profile}{RESET} and retry.\n", flush=True)
                    sys.exit(1)

                # Export live STS credentials so Terraform's AWS provider NEVER fails on Go SDK SSO cache bugs!
                creds = export_aws_profile_credentials(active_profile)
                if creds.get("AccessKeyId"):
                    env["AWS_ACCESS_KEY_ID"] = creds["AccessKeyId"]
                    env["AWS_SECRET_ACCESS_KEY"] = creds["SecretAccessKey"]
                    if creds.get("SessionToken"):
                        env["AWS_SESSION_TOKEN"] = creds["SessionToken"]
                    # CRITICAL: Remove AWS_PROFILE from env so Terraform's AWS provider doesn't override STS credentials!
                    env.pop("AWS_PROFILE", None)
                else:
                    print(f"\n{RED}✗ Authentication Error: Failed to export active STS credentials for profile '{active_profile}'.{RESET}", flush=True)
                    print(f"  Please run: {CYAN}aws sso login --profile {active_profile}{RESET} and retry.\n", flush=True)
                    sys.exit(1)

    try:
        subprocess.run(cmd, env=env, check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        banner()
        platform_name, _ = get_active_cloud_dir(interactive=False)
        print(f"Active Platform: {CYAN}{platform_name.upper()}{RESET} (change via './ztgw configure')\n")
        print("Usage: ./ztgw <command> [aws|gcp]\n")
        print("Commands:")
        print("  configure   Interactive setup wizard (Topology selection: Dedicated, Shared, Hub-and-Spoke)")
        print("  plan        Run terraform plan [optional: aws|gcp]")
        print("  apply       Provision ZTGW + consumer cloud plumbing in one shot [optional: aws|gcp]")
        print("  destroy     Tear down consumer plumbing and deprovision ZTGW [optional: aws|gcp]")
        print("  output      Show Terraform outputs [optional: aws|gcp]\n")
        sys.exit(0)

    cmd = sys.argv[1]
    target_cloud = sys.argv[2] if len(sys.argv) > 2 else ""
    if cmd == "configure":
        configure_wizard()
    elif cmd in ("plan", "apply", "destroy", "output"):
        run_terraform(cmd, target_cloud=target_cloud)
    else:
        print(f"{RED}Unknown command: {cmd}. Run './ztgw help' for usage.{RESET}")
        sys.exit(1)


if __name__ == "__main__":
    main()
