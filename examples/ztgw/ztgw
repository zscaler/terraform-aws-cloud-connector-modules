# --- GCP Discovery -----------------------------------------------------------
def discover_gcp_vpcs(project_id: str) -> list:
    """Returns list of VPC dicts: [{name, autoCreateSubnetworks}, ...] or falls back to plain names."""
    if not shutil.which("gcloud"):
        return []
    try:
        cmd = ["gcloud", "compute", "networks", "list", f"--project={project_id}", "--format=json(name,autoCreateSubnetworks)"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            if isinstance(data, list) and data:
                return data
        cmd_simple = ["gcloud", "compute", "networks", "list", f"--project={project_id}", "--format=value(name)"]
        res_simple = subprocess.run(cmd_simple, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res_simple.returncode == 0:
            return [{"name": line.strip()} for line in res_simple.stdout.splitlines() if line.strip()]
    except Exception:
        pass
    return []


def discover_gcp_subnets(project_id: str, vpc_name: str, region: str = "") -> list:
    """Returns list of Subnet dicts: [{name, ipCidrRange, region}, ...] in selected VPC."""
    if not shutil.which("gcloud"):
        return []
    try:
        cmd = [
            "gcloud", "compute", "networks", "subnets", "list",
            f"--project={project_id}",
            f"--filter=network ~ /{vpc_name}$",
            "--format=json(name,ipCidrRange,region.basename())"
        ]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            if isinstance(data, list) and data:
                if region:
                    return sorted(data, key=lambda s: 0 if s.get("region") == region else 1)
                return data
    except Exception:
        pass
    return []


def discover_gcp_zones(project_id: str, region: str) -> list:
    """Returns list of active zone names in the specified region."""
    if not shutil.which("gcloud"):
        return []
    try:
        cmd = ["gcloud", "compute", "zones", "list", f"--project={project_id}", f"--filter=region:( {region} )", "--format=value(name)"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode == 0:
            zones = [z.strip() for z in res.stdout.splitlines() if z.strip()]
            return sorted(zones)
    except Exception:
        pass
    return []


# --- GCP Project Resolution & Permission Checks ------------------------------
def resolve_gcp_project() -> tuple:
    """Auto-detects active gcloud account and project, asks for confirmation, or allows selection/manual input."""
    active_account = ""
    active_project = ""
    if shutil.which("gcloud"):
        try:
            res_acc = subprocess.run(["gcloud", "config", "get-value", "account"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
            if res_acc.returncode == 0:
                active_account = res_acc.stdout.strip()
            res_prj = subprocess.run(["gcloud", "config", "get-value", "project"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
            if res_prj.returncode == 0:
                active_project = res_prj.stdout.strip()
        except Exception:
            pass

    if active_project:
        acc_str = f" (Account: {active_account})" if active_account else ""
        confirm = prompt_input(f"Detected active GCP Project '{active_project}'{acc_str}. Use this project? (y/n)", default="y")
        if confirm.lower() in ("y", "yes"):
            print(f"{GREEN}✓ Using GCP Project: {active_project}{RESET}\n")
            return active_project, active_account

    # List available projects if gcloud is logged in
    projects = []
    if shutil.which("gcloud"):
        try:
            res = subprocess.run(["gcloud", "projects", "list", "--format=value(projectId)", "--limit=20"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
            if res.returncode == 0:
                projects = [p.strip() for p in res.stdout.splitlines() if p.strip()]
        except Exception:
            pass

    if projects:
        print(f"\n{BOLD}Available GCP Projects on system:{RESET}")
        for idx, prj in enumerate(projects, 1):
            print(f"  [{idx}] {prj}")
        choice = prompt_input("Select project number or enter Project ID", default=projects[0])
        try:
            selected = projects[int(choice) - 1]
        except Exception:
            selected = choice
        print(f"{GREEN}✓ Using GCP Project: {selected}{RESET}\n")
        return selected, active_account
    else:
        return prompt_input("Primary GCP Project ID"), active_account


def verify_gcp_permissions(project_id: str):
    """Performs a pre-flight IAM check for required GCP NSI roles."""
    print(f"{CYAN}--> Checking GCP IAM permissions for project '{project_id}'...{RESET}")
    if not shutil.which("gcloud"):
        print(f"{YELLOW}⚠ 'gcloud' CLI not found. Skipping GCP permission pre-flight check.{RESET}")
        print(f"  Required roles: roles/compute.networkAdmin and roles/networksecurity.admin\n")
        return

    required_perms = [
        "compute.networks.get",
        "compute.firewallPolicies.create",
        "networksecurity.interceptEndpointGroups.create",
        "networksecurity.securityProfiles.create",
    ]
    try:
        cmd = ["gcloud", "projects", "test-iam-permissions", project_id, f"--permissions={','.join(required_perms)}", "--format=value(permissions)"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
        if res.returncode == 0:
            granted = set(res.stdout.strip().split())
            missing = [p for p in required_perms if p not in granted]
            if not missing:
                print(f"{GREEN}✓ GCP IAM permissions verified (Network Admin & Network Security Admin granted){RESET}\n")
            else:
                print(f"{YELLOW}⚠ Notice: Principal may be missing specific GCP permissions on '{project_id}':{RESET}")
                for m in missing:
                    print(f"  - {m}")
                print(f"  Required roles: {BOLD}roles/compute.networkAdmin{RESET} and {BOLD}roles/networksecurity.admin{RESET}\n")
        else:
            print(f"{YELLOW}ℹ Could not test IAM permissions via gcloud. Proceeding with deployment...{RESET}\n")
    except Exception:
        print(f"{YELLOW}ℹ Permission pre-check skipped. Proceeding...{RESET}\n")


# --- AWS Profiles & Discovery ------------------------------------------------
def get_available_aws_profiles() -> dict:
    """Parses ~/.aws/config to discover available AWS profiles and account associations."""
    profiles = {}
    config_path = os.path.expanduser("~/.aws/config")
    if os.path.exists(config_path):
        current = None
        try:
            with open(config_path, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("[profile ") and line.endswith("]"):
                        current = line[9:-1].strip()
                        profiles[current] = {}
                    elif line == "[default]":
                        current = "default"
                        profiles[current] = {}
                    elif current and "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip()
                        if k in ("sso_account_id", "region"):
                            profiles[current][k] = v
        except Exception:
            pass
    return profiles


def check_and_login_aws_profile(profile: str) -> bool:
    """Checks if AWS profile session is valid. If expired, prompts and executes aws sso login."""
    if not profile or not shutil.which("aws"):
        return True
    env = os.environ.copy()
    env["AWS_PROFILE"] = profile
    cmd = ["aws", "sts", "get-caller-identity", "--output", "json"]
    try:
        res = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    # Quick retry once for transient proxy latency
    try:
        time.sleep(1)
        res = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
        if res.returncode == 0:
            return True
    except Exception:
        pass

    err = res.stderr.strip() if 'res' in locals() else "Timeout"
    print(f"\n{YELLOW}⚠ AWS session for profile '{profile}' is expired or unauthorized: {err}{RESET}")
    if not sys.stdin.isatty():
        return False
    ans = prompt_input(f"Run 'aws sso login --profile {profile}' now? (y/n)", default="y")
    if ans.lower() in ("y", "yes"):
        print(f"\n{CYAN}--> Running 'aws sso login --profile {profile}'...{RESET}")
        login_res = subprocess.run(["aws", "sso", "login", f"--profile={profile}"])
        if login_res.returncode == 0:
            res2 = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=15)
            if res2.returncode == 0:
                data = json.loads(res2.stdout)
                arn = data.get("Arn", "unknown")
                print(f"{GREEN}✓ Successfully authenticated via AWS SSO as: {arn}{RESET}\n")
                return True
            else:
                print(f"{RED}✗ Authentication still failing after login: {res2.stderr.strip()}{RESET}\n")
    return False


def resolve_aws_profile(account_id: str = "") -> str:
    """Auto-picks the best matching AWS profile, asks for user confirmation, or offers a switch menu."""
    profiles = get_available_aws_profiles()
    auto_picked = os.environ.get("AWS_PROFILE", "")

    # If no env variable, match by account_id in discovered profiles
    if not auto_picked and account_id and profiles:
        for name, details in profiles.items():
            if details.get("sso_account_id") == account_id:
                auto_picked = name
                break

    if not auto_picked:
        if "default" in profiles:
            auto_picked = "default"
        elif profiles:
            auto_picked = list(profiles.keys())[0]

    if auto_picked:
        acc_info = ""
        if auto_picked in profiles and profiles[auto_picked].get("sso_account_id"):
            acc_info = f" (Account: {profiles[auto_picked]['sso_account_id']})"
        confirm = prompt_input(f"Detected AWS Profile '{auto_picked}'{acc_info}. Use this profile? (y/n)", default="y")
        if confirm.lower() in ("y", "yes"):
            print(f"{GREEN}✓ Using AWS Profile: {auto_picked}{RESET}\n")
            check_and_login_aws_profile(auto_picked)
            return auto_picked

    # If user declined or auto-pick failed, display list of all available profiles
    if profiles:
        print(f"\n{BOLD}Available AWS Profiles on system:{RESET}")
        prof_keys = list(profiles.keys())
        for idx, name in enumerate(prof_keys, 1):
            info = []
            if profiles[name].get("sso_account_id"):
                info.append(f"Account: {profiles[name]['sso_account_id']}")
            if profiles[name].get("region"):
                info.append(f"Region: {profiles[name]['region']}")
            info_str = f" ({', '.join(info)})" if info else ""
            print(f"  [{idx}] {name}{info_str}")

        choice = prompt_input("Select profile number or enter profile name", default=prof_keys[0])
        try:
            selected = prof_keys[int(choice) - 1]
        except Exception:
            selected = choice
        print(f"{GREEN}✓ Using AWS Profile: {selected}{RESET}\n")
        check_and_login_aws_profile(selected)
        return selected
    else:
        prof = prompt_input("Enter AWS Profile name", default="default")
        check_and_login_aws_profile(prof)
        return prof


def discover_aws_vpcs(region: str, profile: str = "") -> list:
    """Returns list of VPC dicts: [{Id, Name, Cidr}, ...] or falls back gracefully."""
    if not shutil.which("aws"):
        return []
    try:
        cmd = ["aws", "ec2", "describe-vpcs", f"--region={region}", "--query", "Vpcs[*].{Id:VpcId,Cidr:CidrBlock,Name:Tags[?Key=='Name']|[0].Value}", "--output", "json"]
        if profile:
            cmd.append(f"--profile={profile}")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            if isinstance(data, list) and data:
                return data
        # Fallback for older AWS CLI v1
        cmd_simple = ["aws", "ec2", "describe-vpcs", f"--region={region}", "--query", "Vpcs[*].VpcId", "--output", "text"]
        if profile:
            cmd_simple.append(f"--profile={profile}")
        res_simple = subprocess.run(cmd_simple, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res_simple.returncode == 0:
            ids = res_simple.stdout.strip().split()
            return [{"Id": i, "Name": None, "Cidr": None} for i in ids if i]
    except Exception:
        pass
    return []


