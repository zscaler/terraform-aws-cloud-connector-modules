            f"--filters=Name=vpc-id,Values={vpc_id}",
            "--query", "Subnets[*].{Id:SubnetId,AZ:AvailabilityZone,AZId:AvailabilityZoneId,Cidr:CidrBlock,Name:Tags[?Key=='Name']|[0].Value}",
            "--output", "json"
        ]
        if profile:
            cmd.append(f"--profile={profile}")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            if isinstance(data, list) and data:
                return data
        # Fallback for older AWS CLI v1
        cmd_simple = ["aws", "ec2", "describe-subnets", f"--region={region}", f"--filters=Name=vpc-id,Values={vpc_id}", "--query", "Subnets[*].SubnetId", "--output", "text"]
        if profile:
            cmd_simple.append(f"--profile={profile}")
        res_simple = subprocess.run(cmd_simple, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res_simple.returncode == 0:
            ids = res_simple.stdout.strip().split()
            return [{"Id": i, "AZ": None, "Cidr": None, "Name": None} for i in ids if i]
    except Exception:
        pass
    return []


def discover_aws_region_azs(region: str, profile: str = "") -> list:
    """Returns all available Availability Zones in the region with their physical Zone IDs: [{ZoneName, ZoneId}, ...]."""
    if not shutil.which("aws"):
        return []
    try:
        cmd = ["aws", "ec2", "describe-availability-zones", f"--region={region}", "--output", "json"]
        if profile:
            cmd.append(f"--profile={profile}")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            azs = [
                {"ZoneName": item["ZoneName"], "ZoneId": item["ZoneId"]}
                for item in data.get("AvailabilityZones", [])
                if item.get("State") == "available"
            ]
            return sorted(azs, key=lambda x: x["ZoneName"])
    except Exception:
        pass
    return []


def get_supported_ztgw_letter_zones(region: str, profile: str = "") -> list:
    """Finds which letter Availability Zones in this AWS account map to Zscaler's physical deployment zones."""
    if not shutil.which("aws"):
        return []
    try:
        cmd = ["aws", "ec2", "describe-availability-zones", f"--region={region}", "--output", "json"]
        if profile:
            cmd.append(f"--profile={profile}")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            supported = []
            for item in data.get("AvailabilityZones", []):
                zid = item.get("ZoneId", "").lower()
                zname = item.get("ZoneName", "")
                if region == "us-east-1":
                    if zid in ("use1-az1", "use1-az5", "use1-az2"):
                        supported.append(zname)
                else:
                    if zid.endswith("-az1") or zid.endswith("-az2"):
                        supported.append(zname)
            return sorted(supported)
    except Exception:
        pass
    return []


def export_aws_profile_credentials(profile: str) -> dict:
    """Exports active STS temporary credentials from AWS CLI so Terraform / Go SDK never fails on SSO cache mismatches."""
    if not shutil.which("aws"):
        return {}
    try:
        cmd = ["aws", "configure", "export-credentials", f"--profile={profile}"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode == 0:
            return json.loads(res.stdout)
    except Exception:
        pass
    return {}


