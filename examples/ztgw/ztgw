            f"--region={region}",
            f"--filters=Name=vpc-id,Values={vpc_id}",
            "--query", "RouteTables[*].{Id:RouteTableId,Name:Tags[?Key=='Name']|[0].Value,Main:Associations[?Main==`true`]|[0].Main,DefaultRouteTarget:Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].GatewayId || Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].NatGatewayId || Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].VpcEndpointId}",
            "--output", "json"
        ]
        if profile:
            cmd.append(f"--profile={profile}")
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            if isinstance(data, list) and data:
                return data
        # Fallback for older AWS CLI v1
        cmd_simple = ["aws", "ec2", "describe-route-tables", f"--region={region}", f"--filters=Name=vpc-id,Values={vpc_id}", "--query", "RouteTables[*].RouteTableId", "--output", "text"]
        if profile:
            cmd_simple.append(f"--profile={profile}")
        res_simple = subprocess.run(cmd_simple, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res_simple.returncode == 0:
            ids = res_simple.stdout.strip().split()
            return [{"Id": i, "Name": None, "Main": None, "DefaultRouteTarget": None} for i in ids if i]
    except Exception:
        pass
    return []


def check_gcp_vpc_enforcement_order(project_id: str, vpc_name: str):
    """Checks if GCP VPC has networkFirewallPolicyEnforcementOrder = BEFORE_CLASSIC_FIREWALL."""
    if not shutil.which("gcloud"):
        return
    try:
        cmd = ["gcloud", "compute", "networks", "describe", vpc_name, f"--project={project_id}", "--format=value(networkFirewallPolicyEnforcementOrder)"]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res.returncode == 0:
            order = res.stdout.strip()
            if order and order != "BEFORE_CLASSIC_FIREWALL":
                print(f"\n{YELLOW}⚠ Notice: VPC '{vpc_name}' has networkFirewallPolicyEnforcementOrder = '{order}'.{RESET}")
                print(f"  For Google Cloud NSI to evaluate firewall policy rules before classic VPC rules, run:")
                print(f"  {CYAN}gcloud compute networks update {vpc_name} --project={project_id} --network-firewall-policy-enforcement-order=BEFORE_CLASSIC_FIREWALL{RESET}\n")
    except Exception:
        pass


def verify_aws_permissions(region: str, profile: str = "", access_key: str = "", secret_key: str = "", session_token: str = ""):
    """Performs a pre-flight STS identity and EC2 permission check for AWS."""
    print(f"\n{CYAN}--> Checking AWS credentials and permissions in {region}...{RESET}")
    if not shutil.which("aws"):
        print(f"{YELLOW}⚠ 'aws' CLI not found. Skipping AWS permission pre-flight check.{RESET}\n")
        return

    env = os.environ.copy()
    if access_key and secret_key:
        env["AWS_ACCESS_KEY_ID"] = access_key
        env["AWS_SECRET_ACCESS_KEY"] = secret_key
        if session_token:
            env["AWS_SESSION_TOKEN"] = session_token
    elif profile:
        env["AWS_PROFILE"] = profile

    try:
        cmd_sts = ["aws", "sts", "get-caller-identity", "--output", "json"]
        res_sts = subprocess.run(cmd_sts, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        if res_sts.returncode != 0 and profile:
            # Session expired: prompt and log in
            if check_and_login_aws_profile(profile):
                res_sts = subprocess.run(cmd_sts, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)

        if res_sts.returncode == 0:
            data = json.loads(res_sts.stdout)
            arn = data.get("Arn", "unknown")
            print(f"{GREEN}✓ Authenticated as: {arn}{RESET}")
            cmd_ec2 = ["aws", "ec2", "describe-vpcs", f"--region={region}", "--max-results=5"]
            res_ec2 = subprocess.run(cmd_ec2, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
            if res_ec2.returncode == 0:
                print(f"{GREEN}✓ EC2 Network permissions verified in {region}{RESET}\n")
            else:
                print(f"{YELLOW}⚠ Warning: Could not describe VPCs in {region}: {res_ec2.stderr.strip()}{RESET}\n")
        else:
            print(f"{RED}✗ AWS Authentication check failed: {res_sts.stderr.strip()}{RESET}\n")
    except Exception as e:
        print(f"{YELLOW}ℹ AWS permission pre-check skipped: {e}{RESET}\n")


