#!/usr/bin/env bash
# ==============================================================================
# zsec — Zscaler Unified Zero Trust Gateway (ZTGW) Pure-Bash Deployment Tool
#
# Supports:
#   - Clouds:     Google Cloud (GCP) & Amazon Web Services (AWS)
#   - Modes:      Full (ZTGW + Consumer), ZTGW-Only, Consumer-Only
#   - Topologies: Dedicated (1:1), Shared (Multi-VPC), Hub-and-Spoke
#
# 100% Pure Bash — No Python required for this interactive CLI.
# ==============================================================================

set -eo pipefail

### COLOR CODES ###
RED=$(tput setaf 1 2>/dev/null || echo "")
GREEN=$(tput setaf 2 2>/dev/null || echo "")
YELLOW=$(tput setaf 3 2>/dev/null || echo "")
CYAN=$(tput setaf 6 2>/dev/null || echo "")
BOLD=$(tput bold 2>/dev/null || echo "")
RESET=$(tput sgr0 2>/dev/null || echo "")

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

# Force Go binaries (Terraform and cloud providers) to use OS resolver (cgo) instead of dead IPv6 DNS servers
export GODEBUG="netdns=cgo"

usage() {
    echo ""
    echo "Usage: $0 <configure|apply|up|plan|destroy|output> [aws|gcp]"
    echo ""
    echo "  configure  Interactive setup wizard (discover VPCs, subnets, and OneAPI)"
    echo "  apply/up   Deploy ZTGW + cloud consumer plumbing"
    echo "  plan       Show Terraform plan preview for active configuration"
    echo "  output     Show Terraform outputs"
    echo "  destroy    Tear down all cloud resources and deprovision ZTGW"
    echo ""
    exit 1
}

banner() {
    echo ""
    echo "${GREEN}${BOLD}============================================================${RESET}"
    echo "${GREEN}${BOLD}      Zscaler Unified Zero Trust Gateway (ZTGW) Engine     ${RESET}"
    echo "${GREEN}${BOLD}       Pure-Bash Interactive Deployer (GCP & AWS)           ${RESET}"
    echo "${GREEN}${BOLD}============================================================${RESET}"
    echo ""
}

if [ $# -lt 1 ]; then
    usage
fi

oper=$1
case "$oper" in
    configure|up|apply|plan|destroy|output) ;;
    *) usage ;;
esac

banner

# ---------------------------------------------------------------------------
# Ensure Terraform binary is available
# ---------------------------------------------------------------------------
if ! command -v terraform &>/dev/null; then
    if [ -x "./bin/terraform" ]; then
        export PATH="${DIR}/bin:${PATH}"
    else
        echo "${YELLOW}'terraform' not found in system PATH.${RESET}"
        echo "Detecting OS to install Terraform..."
        archdetect=$(uname -m)
        tversion="1.9.5"

        case "$archdetect" in
            x86_64|amd64) arch=amd64 ;;
            aarch64|arm64) arch=arm64 ;;
            *) arch=amd64 ;;
        esac

        if [[ "$OSTYPE" == "linux"* ]]; then
            os_str=linux
        elif [[ "$OSTYPE" == "darwin"* ]]; then
            os_str=darwin
        elif [[ "$OSTYPE" == "freebsd"* ]]; then
            os_str=freebsd
        else
            echo "${RED}Unsupported OS: $OSTYPE. Please install Terraform manually.${RESET}"
            exit 1
        fi

        mkdir -p ./bin
        echo "Downloading Terraform v${tversion} for ${os_str}_${arch}..."
        curl -so ./bin/terraform.zip "https://releases.hashicorp.com/terraform/${tversion}/terraform_${tversion}_${os_str}_${arch}.zip"
        unzip -qo ./bin/terraform.zip -d ./bin
        rm -f ./bin/terraform.zip
        chmod +x ./bin/terraform
        export PATH="${DIR}/bin:${PATH}"
        echo "${GREEN}Terraform ready in ./bin/${RESET}"
    fi
fi

# ---------------------------------------------------------------------------
# Interactive Configuration Wizard (runs if configure or .zsecrc does not exist)
# ---------------------------------------------------------------------------
if [[ "$oper" == "configure" || (("$oper" == "up" || "$oper" == "plan") && ! -f ./.zsecrc) ]]; then
    echo "${YELLOW}Starting Interactive Configuration Wizard...${RESET}"
    echo ""

    # 1. Cloud Platform
    echo "${BOLD}Select Cloud Platform:${RESET}"
    echo "  [1] Google Cloud (GCP)"
    echo "  [2] Amazon Web Services (AWS)"
    read -r -p "Enter selection [1]: " cloud_sel
    cloud_sel=${cloud_sel:-1}
    if [[ "$cloud_sel" == "2" ]]; then
        TARGET_CLOUD="aws"
        EXAMPLE_DIR="${DIR}/examples/aws/end-to-end"
    else
        TARGET_CLOUD="gcp"
        EXAMPLE_DIR="${DIR}/examples/gcp/end-to-end"
    fi
    echo ""

    # 2. Deployment Mode
    echo "${BOLD}Select Deployment Mode:${RESET}"
    echo "  [1] Full Deployment   — Provision ZTGW + wire cloud consumer plumbing (Recommended)"
    echo "      ${CYAN}• Deploys managed gateway in Zscaler and attaches your customer VPC in a single step.${RESET}"
    echo "  [2] ZTGW Only         — Provision ZTGW in Zscaler and output connection handle"
    echo "      ${CYAN}• Best for InfoSec teams creating central gateways without managing customer VPCs.${RESET}"
    echo "  [3] Consumer Only     — Connect an existing ZTGW to customer VPCs"
    echo "      ${CYAN}• Best for App/Cloud teams connecting VPCs using an existing IDG or Endpoint Service.${RESET}"
    read -r -p "Enter selection [1]: " mode_sel
    mode_sel=${mode_sel:-1}

    DEPLOY_ZTGW="true"
    DEPLOY_CONSUMER="true"
    case "$mode_sel" in
        2)
            DEPLOY_ZTGW="true"
            DEPLOY_CONSUMER="false"
            ;;
        3)
            DEPLOY_ZTGW="false"
            DEPLOY_CONSUMER="true"
            ;;
        *)
            DEPLOY_ZTGW="true"
            DEPLOY_CONSUMER="true"
            ;;
    esac
    echo ""

    # 3. Zscaler OneAPI Credentials (if DEPLOY_ZTGW is true)
    CLIENT_ID=""
    CLIENT_SECRET=""
    VANITY=""
    CLOUD_ENV="zscaler"
    INSECURE_VERIFY="false"

    if [[ "$DEPLOY_ZTGW" == "true" ]]; then
        echo "${BOLD}Zscaler OneAPI Credentials${RESET}"
        read -r -p "Zscaler Vanity Domain (e.g. acme for acme.zslogin.net): " VANITY
        echo "${CYAN}Available Clouds: zscaler, zscalerbeta, zscalerone, zscalertwo, zscalerthree${RESET}"
        read -r -p "Zscaler Cloud [zscaler]: " CLOUD_ENV
        CLOUD_ENV=${CLOUD_ENV:-zscaler}
        read -r -p "Zscaler Client ID: " CLIENT_ID
        read -r -s -p "Zscaler Client Secret: " CLIENT_SECRET
        echo ""

        # Pre-flight check: Validating Zscaler OneAPI credentials
        echo ""
        echo "${CYAN}--> Pre-flight check: Validating Zscaler OneAPI credentials...${RESET}"
        login_domain="zslogin.net"
        clean_cloud=$(echo "$CLOUD_ENV" | tr '[:upper:]' '[:lower:]')
        case "$clean_cloud" in
            zscalerbeta) login_domain="zsloginbeta.net" ;;
            zscalerthree) login_domain="zsloginthree.net" ;;
            zscalerone) login_domain="zsloginone.net" ;;
            zscalertwo) login_domain="zslogintwo.net" ;;
        esac
        token_url="https://${VANITY}.${login_domain}/oauth2/v1/token"

        auth_success=false
        insecure_needed=false

        if command -v curl &>/dev/null; then
            token_resp=$(curl -s -X POST "$token_url" \
                -H "Content-Type: application/x-www-form-urlencoded" \
                -d "grant_type=client_credentials&client_id=${CLIENT_ID}&client_secret=${CLIENT_SECRET}" 2>/dev/null || true)
            if [[ "$token_resp" == *"access_token"* ]]; then
                auth_success=true
            else
                # Try with -k / insecure in case corporate TLS proxy / ZCC is active
                token_resp_k=$(curl -s -k -X POST "$token_url" \
                    -H "Content-Type: application/x-www-form-urlencoded" \
                    -d "grant_type=client_credentials&client_id=${CLIENT_ID}&client_secret=${CLIENT_SECRET}" 2>/dev/null || true)
                if [[ "$token_resp_k" == *"access_token"* ]]; then
                    auth_success=true
                    insecure_needed=true
                fi
            fi
        fi

        if [[ "$auth_success" == "true" ]]; then
            if [[ "$insecure_needed" == "true" ]]; then
                echo "${GREEN}✓ Authentication successful with Zscaler OneAPI (corporate proxy mode: insecure_skip_verify = true enabled)${RESET}"
                INSECURE_VERIFY="true"
            else
                echo "${GREEN}✓ Authentication successful with Zscaler OneAPI!${RESET}"
            fi
        else
            echo "${YELLOW}⚠ Warning: Could not verify Zscaler OneAPI credentials automatically.${RESET}"
            read -r -p "Skip SSL verification for TLS proxies / ZCC? (y/n) [n]: " skip_ssl
            if [[ "$skip_ssl" =~ ^[Yy] ]]; then
                INSECURE_VERIFY="true"
            fi
        fi
        echo ""
    fi

    # 4. Topology Selection
    echo "${BOLD}Deployment Topology Selection:${RESET}"
    echo "  [1] Dedicated (1:1)       — Protect a single workload VPC (Isolated)"
    echo "      ${CYAN}• 1 Gateway per VPC: Zero cross-VPC blast radius, independent scaling.${RESET}"
    echo "  [2] Shared (Multi-VPC)    — Protect multiple VPCs/projects with one shared ZTGW"
    echo "      ${CYAN}• Maximum cost efficiency: 1 gateway shared across VPCs via cloud SDN without peering.${RESET}"
    echo "  [3] Hub-and-Spoke         — Protect a Central Inspection Hub VPC (Peering / TGW / NCC)"
    echo "      ${CYAN}• Spoke VPCs route through a central inspection transit hub before reaching ZTGW.${RESET}"
    read -r -p "Enter selection [1]: " topo_sel
    topo_sel=${topo_sel:-1}
    echo ""

    # 5. Cloud-Specific Parameters
    TFVARS="${EXAMPLE_DIR}/terraform.tfvars"

    if [[ "$TARGET_CLOUD" == "gcp" ]]; then
        echo "${BOLD}Google Cloud Environment Settings${RESET}"

        # Auto-detect active GCP account and project
        GCP_PROJECT=""
        detected_project=$(gcloud config get-value project 2>/dev/null || true)
        detected_account=$(gcloud config get-value account 2>/dev/null || true)

        if [[ -n "$detected_project" ]]; then
            echo "${CYAN}Detected active GCP Project: '${detected_project}' (Account: ${detected_account})${RESET}"
            read -r -p "Use this project? (y/n) [y]: " confirm_prj
            confirm_prj=${confirm_prj:-y}
            if [[ "$confirm_prj" =~ ^[Yy] ]]; then
                GCP_PROJECT="$detected_project"
            fi
        fi

        if [[ -z "$GCP_PROJECT" ]]; then
            # List available projects if logged in
            if command -v gcloud &>/dev/null; then
                projects=($(gcloud projects list --format="value(projectId)" --limit=15 2>/dev/null || true))
                if [[ ${#projects[@]} -gt 0 ]]; then
                    echo ""
                    echo "${BOLD}Available GCP Projects on system:${RESET}"
                    for idx in "${!projects[@]}"; do
                        echo "  [$((idx+1))] ${projects[$idx]}"
                    done
                    read -r -p "Select project number or enter Project ID [${projects[0]}]: " prj_choice
                    prj_choice=${prj_choice:-1}
                    if [[ "$prj_choice" =~ ^[0-9]+$ ]] && [ "$prj_choice" -le "${#projects[@]}" ] && [ "$prj_choice" -gt 0 ]; then
                        GCP_PROJECT="${projects[$((prj_choice-1))]}"
                    else
                        GCP_PROJECT="$prj_choice"
                    fi
                fi
            fi
        fi

        if [[ -z "$GCP_PROJECT" ]]; then
            read -r -p "Primary GCP Project ID: " GCP_PROJECT
        fi
        echo "${GREEN}✓ Using GCP Project: ${GCP_PROJECT}${RESET}"

        # Pre-flight GCP permission check
        echo "${CYAN}--> Checking GCP IAM permissions on '${GCP_PROJECT}'...${RESET}"
        if command -v gcloud &>/dev/null; then
            if gcloud projects test-iam-permissions "$GCP_PROJECT" --permissions="compute.networks.get,networksecurity.interceptEndpointGroups.create" &>/dev/null; then
                echo "${GREEN}✓ GCP IAM permissions verified${RESET}"
            else
                echo "${YELLOW}⚠ Warning: Could not verify networksecurity permissions on '${GCP_PROJECT}'. Ensure roles/networksecurity.admin and roles/compute.networkAdmin are granted.${RESET}"
            fi
        fi
        echo ""

        read -r -p "GCP Region [us-central1]: " GCP_REGION
        GCP_REGION=${GCP_REGION:-us-central1}
        read -r -p "ZTGW Name [gcp-ztgw-${GCP_REGION}]: " ZTGW_NAME
        ZTGW_NAME=${ZTGW_NAME:-gcp-ztgw-${GCP_REGION}}

        EXISTING_IDG=""
        if [[ "$DEPLOY_ZTGW" == "false" ]]; then
            read -r -p "Existing ZTGW Intercept Deployment Group URI: " EXISTING_IDG
        fi

        VPC_BLOCK=""
        if [[ "$DEPLOY_CONSUMER" == "true" ]]; then
            # 1. Discover GCP VPCs
            gcp_vpcs=()
            if command -v gcloud &>/dev/null; then
                while IFS= read -r v; do
                    [[ -n "$v" ]] && gcp_vpcs+=("$v")
                done < <(gcloud compute networks list --project="${GCP_PROJECT}" --format="value(name)" 2>/dev/null || true)
            fi

            if [[ ${#gcp_vpcs[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}Discovered existing VPC networks in ${GCP_PROJECT}:${RESET}"
                for idx in "${!gcp_vpcs[@]}"; do
                    echo "  [$((idx+1))] ${gcp_vpcs[$idx]}"
                done
                read -r -p "Select VPC number or enter name [${gcp_vpcs[0]}]: " vpc_choice
                vpc_choice=${vpc_choice:-1}
                if [[ "$vpc_choice" =~ ^[0-9]+$ ]] && [ "$vpc_choice" -le "${#gcp_vpcs[@]}" ] && [ "$vpc_choice" -gt 0 ]; then
                    VPC_NAME="${gcp_vpcs[$((vpc_choice-1))]}"
                else
                    VPC_NAME="$vpc_choice"
                fi
            else
                echo "${YELLOW}ℹ GCP discovery unavailable or returned no VPCs. Defaulting to manual input.${RESET}"
                read -r -p "Name of existing Workload VPC network [default]: " VPC_NAME
                VPC_NAME=${VPC_NAME:-default}
            fi
            echo "${GREEN}✓ Using VPC: ${VPC_NAME}${RESET}"

            # Check networkFirewallPolicyEnforcementOrder
            if command -v gcloud &>/dev/null; then
                order=$(gcloud compute networks describe "$VPC_NAME" --project="$GCP_PROJECT" --format="value(networkFirewallPolicyEnforcementOrder)" 2>/dev/null || true)
                if [[ -n "$order" && "$order" != "BEFORE_CLASSIC_FIREWALL" ]]; then
                    echo "${YELLOW}⚠ Notice: VPC '${VPC_NAME}' has networkFirewallPolicyEnforcementOrder = '${order}'.${RESET}"
                    echo "  For Google Cloud NSI to evaluate firewall policy rules before classic VPC rules, run:"
                    echo "  ${CYAN}gcloud compute networks update ${VPC_NAME} --project=${GCP_PROJECT} --network-firewall-policy-enforcement-order=BEFORE_CLASSIC_FIREWALL${RESET}"
                fi
            fi

            # 2. Discover Subnets in selected VPC
            BYPASS_CIDR="10.0.0.0/16"
            gcp_subnets=()
            if command -v gcloud &>/dev/null; then
                while IFS=$'\t' read -r s_name s_cidr; do
                    if [[ -n "$s_name" && -n "$s_cidr" ]]; then
                        gcp_subnets+=("${s_name} (CIDR: ${s_cidr})")
                        BYPASS_CIDR="$s_cidr"
                    fi
                done < <(gcloud compute networks subnets list --project="${GCP_PROJECT}" --filter="network ~ /${VPC_NAME}$" --format="value(name,ipCidrRange)" 2>/dev/null || true)
            fi

            if [[ ${#gcp_subnets[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}Discovered subnets in VPC '${VPC_NAME}':${RESET}"
                for idx in "${!gcp_subnets[@]}"; do
                    echo "  [$((idx+1))] ${gcp_subnets[$idx]}"
                done
            fi

            read -r -p "Internal Subnet CIDR to bypass Zscaler [${BYPASS_CIDR}]: " entered_cidr
            BYPASS_CIDR=${entered_cidr:-$BYPASS_CIDR}
            echo "${GREEN}✓ Using Bypass CIDR: ${BYPASS_CIDR}${RESET}"

            VPC_BLOCK="vpcs = {
  workload-vpc = {
    network_name        = \"${VPC_NAME}\"
    egress_destinations = [\"0.0.0.0/0\"]
    egress_bypass_destinations = [
      \"${BYPASS_CIDR}\",
      \"35.235.240.0/20\",
      \"35.191.0.0/16\",
      \"130.211.0.0/22\",
      \"199.36.153.8/30\"
    ]
    enable_firewall_logging = false
  }
}"
        else
            VPC_BLOCK="vpcs = {}"
        fi

        cat <<EOF > "$TFVARS"
# Generated by ./zsec (Pure Bash)
customer_project_id  = "${GCP_PROJECT}"
region               = "${GCP_REGION}"
deploy_key           = "ztgw-nsi"
deploy_ztgw          = ${DEPLOY_ZTGW}
deploy_consumer      = ${DEPLOY_CONSUMER}
insecure_skip_verify = ${INSECURE_VERIFY}

gateway_name         = "${ZTGW_NAME}"
location_name        = "Unified-GCP-${GCP_REGION}"
availability_zones   = ["${GCP_REGION}-a", "${GCP_REGION}-b"]

client_id            = "${CLIENT_ID}"
client_secret        = "${CLIENT_SECRET}"
vanity_domain        = "${VANITY}"
cloud                = "${CLOUD_ENV}"

$(if [[ -n "$EXISTING_IDG" ]]; then echo "intercept_deployment_group = \"${EXISTING_IDG}\""; fi)

${VPC_BLOCK}
EOF
        chmod 600 "$TFVARS"

    else
        # AWS Platform
        echo "${BOLD}Amazon Web Services (AWS) Environment Settings${RESET}"
        read -r -p "Customer 12-digit AWS Account ID: " AWS_ACCOUNT

        echo ""
        echo "${BOLD}AWS Authentication Method:${RESET}"
        echo "  [1] AWS Profile (SSO / ~/.aws/config) [Recommended for local CLI]"
        echo "  [2] Static Credentials (Access Key & Secret Key)"
        echo "  [3] IAM Role / Cloud Identity (EC2 Instance Profile, EKS IRSA, or Env Vars) [Recommended for CI/CD & EC2]"
        read -r -p "Enter selection [1]: " aws_auth_sel
        aws_auth_sel=${aws_auth_sel:-1}

        AWS_ACCESS_KEY=""
        AWS_SECRET_KEY=""
        AWS_SESSION_TOKEN=""
        SELECTED_AWS_PROFILE=""

        if [[ "$aws_auth_sel" == "2" ]]; then
            read -r -p "AWS Access Key ID: " AWS_ACCESS_KEY
            read -r -s -p "AWS Secret Access Key: " AWS_SECRET_KEY
            echo ""
            read -r -s -p "AWS Session Token (optional, for temporary STS): " AWS_SESSION_TOKEN
            echo ""
        elif [[ "$aws_auth_sel" == "3" ]]; then
            echo "${CYAN}--> Using default AWS credential provider chain (IAM Instance Profile, EKS IRSA, or Environment Variables)${RESET}"
        else
            # Auto-pick AWS Profile
            detected_profile=""
            if [[ -n "$AWS_PROFILE" ]]; then
                detected_profile="$AWS_PROFILE"
            elif [[ -n "$AWS_ACCOUNT" && -f ~/.aws/config ]]; then
                matched_prof=$(grep -B 4 "sso_account_id = ${AWS_ACCOUNT}" ~/.aws/config 2>/dev/null | grep -E '^\[profile ' | head -n 1 | sed 's/\[profile //; s/\]//')
                if [[ -n "$matched_prof" ]]; then
                    detected_profile="$matched_prof"
                fi
            fi

            if [[ -z "$detected_profile" ]]; then
                detected_profile="default"
            fi

            echo "${CYAN}Detected AWS Profile: '${detected_profile}'${RESET}"
            read -r -p "Use profile '${detected_profile}'? (y/n) [y]: " confirm_prof
            confirm_prof=${confirm_prof:-y}

            SELECTED_AWS_PROFILE="$detected_profile"
            if [[ ! "$confirm_prof" =~ ^[Yy] ]]; then
                echo ""
                echo "${BOLD}Available AWS Profiles on system:${RESET}"
                available_profs=()
                if command -v aws &>/dev/null; then
                    while IFS= read -r p; do
                        [[ -n "$p" ]] && available_profs+=("$p")
                    done < <(aws configure list-profiles 2>/dev/null || true)
                fi
                if [[ ${#available_profs[@]} -eq 0 && -f ~/.aws/config ]]; then
                    while IFS= read -r p; do
                        [[ -n "$p" ]] && available_profs+=("$p")
                    done < <(grep -E '^\[profile ' ~/.aws/config 2>/dev/null | sed 's/\[profile //; s/\]//')
                fi

                if [[ ${#available_profs[@]} -gt 0 ]]; then
                    for idx in "${!available_profs[@]}"; do
                        echo "  [$((idx+1))] ${available_profs[$idx]}"
                    done
                    read -r -p "Select profile number or enter name [${available_profs[0]}]: " prof_choice
                    prof_choice=${prof_choice:-1}
                    if [[ "$prof_choice" =~ ^[0-9]+$ ]] && [ "$prof_choice" -le "${#available_profs[@]}" ] && [ "$prof_choice" -gt 0 ]; then
                        SELECTED_AWS_PROFILE="${available_profs[$((prof_choice-1))]}"
                    else
                        SELECTED_AWS_PROFILE="$prof_choice"
                    fi
                else
                    read -r -p "Enter AWS Profile name [default]: " SELECTED_AWS_PROFILE
                    SELECTED_AWS_PROFILE=${SELECTED_AWS_PROFILE:-default}
                fi
            fi
            echo "${GREEN}✓ Using AWS Profile: ${SELECTED_AWS_PROFILE}${RESET}"
        fi
        echo ""

        read -r -p "AWS Region [us-west-2]: " AWS_REGION
        AWS_REGION=${AWS_REGION:-us-west-2}

        # Pre-flight AWS verification
        echo "${CYAN}--> Checking AWS credentials and permissions in ${AWS_REGION}...${RESET}"
        if command -v aws &>/dev/null; then
            check_env=()
            if [[ -n "$AWS_ACCESS_KEY" ]]; then
                export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
                export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
                [[ -n "$AWS_SESSION_TOKEN" ]] && export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"
            elif [[ -n "$SELECTED_AWS_PROFILE" ]]; then
                export AWS_PROFILE="$SELECTED_AWS_PROFILE"
            fi
            caller_identity=$(aws sts get-caller-identity --output json 2>/dev/null || true)
            if [[ -n "$caller_identity" && "$caller_identity" == *"Arn"* ]]; then
                caller_arn=$(echo "$caller_identity" | grep -o '"Arn": *"[^"]*"' | cut -d'"' -f4)
                echo "${GREEN}✓ Authenticated as: ${caller_arn}${RESET}"

                # Check EC2 Network permissions
                if aws ec2 describe-vpcs --region "${AWS_REGION}" --max-items 1 &>/dev/null; then
                    echo "${GREEN}✓ EC2 Network permissions verified in ${AWS_REGION}${RESET}"
                else
                    echo "${YELLOW}⚠ Warning: Could not verify EC2 permissions in ${AWS_REGION}. Ensure ec2:Describe* permissions are granted.${RESET}"
                fi
            elif [[ -n "$SELECTED_AWS_PROFILE" ]]; then
                echo "${YELLOW}⚠ AWS session for profile '${SELECTED_AWS_PROFILE}' appears expired or unauthenticated.${RESET}"
                read -r -p "Run 'aws sso login --profile ${SELECTED_AWS_PROFILE}' now? (y/n) [y]: " confirm_sso
                confirm_sso=${confirm_sso:-y}
                if [[ "$confirm_sso" =~ ^[Yy] ]]; then
                    echo "${CYAN}--> Running 'aws sso login --profile ${SELECTED_AWS_PROFILE}'...${RESET}"
                    aws sso login --profile "${SELECTED_AWS_PROFILE}"
                    caller_identity=$(aws sts get-caller-identity --output json 2>/dev/null || true)
                    if [[ -n "$caller_identity" && "$caller_identity" == *"Arn"* ]]; then
                        caller_arn=$(echo "$caller_identity" | grep -o '"Arn": *"[^"]*"' | cut -d'"' -f4)
                        echo "${GREEN}✓ Authenticated as: ${caller_arn}${RESET}"
                        if aws ec2 describe-vpcs --region "${AWS_REGION}" --max-items 1 &>/dev/null; then
                            echo "${GREEN}✓ EC2 Network permissions verified in ${AWS_REGION}${RESET}"
                        fi
                    else
                        echo "${RED}✗ AWS Authentication still failing after login.${RESET}"
                    fi
                fi
            else
                echo "${YELLOW}⚠ Warning: AWS authentication check failed. Verify your profile or credentials.${RESET}"
            fi
        fi
        echo ""
        AWS_REGION=${AWS_REGION:-us-west-2}
        read -r -p "ZTGW Name [aws-ztgw-${AWS_REGION}]: " ZTGW_NAME
        ZTGW_NAME=${ZTGW_NAME:-aws-ztgw-${AWS_REGION}}

        EXISTING_EP=""
        if [[ "$DEPLOY_ZTGW" == "false" ]]; then
            read -r -p "Existing GWLB Endpoint Service Name (com.amazonaws.vpce...): " EXISTING_EP
        fi

        AWS_CONSUMER_VARS=""
        if [[ "$DEPLOY_CONSUMER" == "true" ]]; then
            # 1. VPC Discovery with Name tags & CIDRs
            vpc_list=()
            vpc_ids=()
            if command -v aws &>/dev/null; then
                while IFS=$'\t' read -r v_id v_name v_cidr; do
                    if [[ -n "$v_id" ]]; then
                        vpc_ids+=("$v_id")
                        name_display=""
                        [[ -n "$v_name" && "$v_name" != "None" ]] && name_display=" — ${v_name}"
                        vpc_list+=("${v_id}${name_display} (CIDR: ${v_cidr})")
                    fi
                done < <(aws ec2 describe-vpcs --region "$AWS_REGION" --query "Vpcs[*].[VpcId,Tags[?Key=='Name']|[0].Value,CidrBlock]" --output text 2>/dev/null || true)
            fi

            if [[ ${#vpc_list[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}Discovered existing VPCs in ${AWS_REGION}:${RESET}"
                for idx in "${!vpc_list[@]}"; do
                    echo "  [$((idx+1))] ${vpc_list[$idx]}"
                done
                read -r -p "Select VPC number or enter ID [1]: " vpc_choice
                vpc_choice=${vpc_choice:-1}
                if [[ "$vpc_choice" =~ ^[0-9]+$ ]] && [ "$vpc_choice" -le "${#vpc_ids[@]}" ] && [ "$vpc_choice" -gt 0 ]; then
                    AWS_VPC="${vpc_ids[$((vpc_choice-1))]}"
                else
                    AWS_VPC="$vpc_choice"
                fi
            else
                echo "${YELLOW}ℹ AWS CLI discovery unavailable or returned no VPCs. Defaulting to manual input.${RESET}"
                read -r -p "Customer VPC ID (e.g. vpc-0123456789abcdef0): " AWS_VPC
            fi
            echo "${GREEN}✓ Using VPC: ${AWS_VPC}${RESET}"

            # 2. Discover Subnets and map subnet counts per Availability Zone
            sub_list=()
            sub_ids=()
            sub_azs=()
            sub_names=()
            sub_cidrs=()
            if command -v aws &>/dev/null; then
                while IFS=$'\t' read -r s_id s_name s_az s_cidr; do
                    if [[ -n "$s_id" ]]; then
                        sub_ids+=("$s_id")
                        sub_azs+=("$s_az")
                        sub_names+=("$s_name")
                        sub_cidrs+=("$s_cidr")
                    fi
                done < <(aws ec2 describe-subnets --region "$AWS_REGION" --filters Name=vpc-id,Values="$AWS_VPC" --query "Subnets[*].[SubnetId,Tags[?Key=='Name']|[0].Value,AvailabilityZone,CidrBlock]" --output text 2>/dev/null || true)
            fi

            # 3. Discover supported ZTGW letter zones in this account (ZoneId ending in -az1 or -az2 or use1-az5)
            supported_ztgw_azs=()
            if command -v aws &>/dev/null; then
                while IFS= read -r z; do
                    [[ -n "$z" ]] && supported_ztgw_azs+=("$z")
                done < <(aws ec2 describe-availability-zones --region "$AWS_REGION" --query "AvailabilityZones[?ends_with(ZoneId, '-az1') || ends_with(ZoneId, '-az2') || ZoneId=='use1-az5'].ZoneName" --output text 2>/dev/null | tr '\t' '\n' || true)
            fi

            if [[ ${#supported_ztgw_azs[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}--> In this AWS account, Zscaler ZTGW in ${AWS_REGION} operates in Availability Zones: ${BOLD}${supported_ztgw_azs[*]}${RESET}"
            fi

            # Build compatible and unsupported subnet lists
            compatible_sub_ids=()
            compatible_sub_display=()
            unsupported_sub_ids=()
            unsupported_sub_names=()
            unsupported_sub_azs=()
            for idx in "${!sub_ids[@]}"; do
                s_id="${sub_ids[$idx]}"
                s_az="${sub_azs[$idx]}"
                s_name="${sub_names[$idx]}"
                s_cidr="${sub_cidrs[$idx]}"
                name_display=""
                [[ -n "$s_name" && "$s_name" != "None" ]] && name_display=" — ${s_name}"
                if [[ ${#supported_ztgw_azs[@]} -eq 0 ]] || [[ " ${supported_ztgw_azs[*]} " =~ " ${s_az} " ]]; then
                    compatible_sub_ids+=("$s_id")
                    compatible_sub_display+=("${s_id}${name_display} (AZ: ${s_az}, CIDR: ${s_cidr}) ${GREEN}[Compatible]${RESET}")
                else
                    unsupported_sub_ids+=("$s_id")
                    unsupported_sub_names+=("${s_id}${name_display}")
                    unsupported_sub_azs+=("$s_az")
                fi
            done

            if [[ ${#compatible_sub_display[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}Subnets compatible to host the ZTGW Endpoint (in ${supported_ztgw_azs[*]}):${RESET}"
                for idx in "${!compatible_sub_display[@]}"; do
                    echo "  [$((idx+1))] ${compatible_sub_display[$idx]}"
                done

                if [[ ${#unsupported_sub_names[@]} -gt 0 ]]; then
                    echo ""
                    echo "${YELLOW}ℹ NOTE: Subnets in other zones cannot host the endpoint interface because Zscaler has no physical dataplane in those AZs:${RESET}"
                    for idx in "${!unsupported_sub_names[@]}"; do
                        echo "    • ${unsupported_sub_names[$idx]} (AZ: ${unsupported_sub_azs[$idx]})"
                    done
                    echo "  Workloads in those zones will automatically route their outbound traffic across the VPC to this endpoint."
                    echo ""
                fi

                sub_default="1,2"
                [[ ${#compatible_sub_display[@]} -lt 2 ]] && sub_default="1"

                while true; do
                    read -r -p "Select subnet number(s) to host the GWLB endpoint (comma-separated, min 1 per AZ) [${sub_default}]: " sub_choice
                    sub_choice=${sub_choice:-$sub_default}
                    selected_subs=()
                    incompatible_err=()
                    IFS=',' read -ra ADDR <<< "$sub_choice"
                    for s_sel in "${ADDR[@]}"; do
                        s_sel=$(echo "$s_sel" | tr -d ' ')
                        if [[ "$s_sel" =~ ^[0-9]+$ ]] && [ "$s_sel" -le "${#compatible_sub_ids[@]}" ] && [ "$s_sel" -gt 0 ]; then
                            cur_id="${compatible_sub_ids[$((s_sel-1))]}"
                            selected_subs+=("\"${cur_id}\"")
                        elif [[ -n "$s_sel" ]]; then
                            for idx in "${!unsupported_sub_ids[@]}"; do
                                if [[ "${unsupported_sub_ids[$idx]}" == "$s_sel" ]]; then
                                    incompatible_err+=("$s_sel (${unsupported_sub_azs[$idx]})")
                                fi
                            done
                            if [[ ${#incompatible_err[@]} -eq 0 ]]; then
                                selected_subs+=("\"${s_sel}\"")
                            fi
                        fi
                    done
                    if [[ ${#incompatible_err[@]} -gt 0 ]]; then
                        echo "${RED}✗ Incompatible subnet selected: ${incompatible_err[*]}${RESET}"
                        echo "  Zscaler ZTGW in ${AWS_REGION} only supports Availability Zones: ${BOLD}${supported_ztgw_azs[*]}${RESET} in this account."
                        echo "  Please select only compatible subnets."
                        continue
                    fi
                    break
                done
                AWS_SUBNETS="[$(IFS=, ; echo "${selected_subs[*]}")]"
            else
                echo "${YELLOW}ℹ Subnet discovery unavailable. Defaulting to manual input.${RESET}"
                read -r -p "Endpoint Subnet IDs (e.g. [\"subnet-1\", \"subnet-2\"]): " AWS_SUBNETS
            fi
            echo "${GREEN}✓ Using Subnets: ${AWS_SUBNETS}${RESET}"

            # 3. Route Table Discovery with Name tags & default route collision check
            rt_list=()
            rt_ids=()
            rt_default_targets=()
            if command -v aws &>/dev/null; then
                while IFS=$'\t' read -r r_id r_name r_main r_def; do
                    if [[ -n "$r_id" ]]; then
                        rt_ids+=("$r_id")
                        rt_default_targets+=("$r_def")
                        name_display=""
                        [[ -n "$r_name" && "$r_name" != "None" ]] && name_display=" — ${r_name}"
                        [[ "$r_main" == "True" ]] && name_display="${name_display} [Main VPC Route Table]"
                        if [[ -n "$r_def" && "$r_def" != "None" ]]; then
                            name_display="${name_display} (Has 0.0.0.0/0 -> ${r_def})"
                        fi
                        rt_list+=("${r_id}${name_display}")
                    fi
                done < <(aws ec2 describe-route-tables --region "$AWS_REGION" --filters Name=vpc-id,Values="$AWS_VPC" --query "RouteTables[*].[RouteTableId,Tags[?Key=='Name']|[0].Value,Associations[?Main==\`true\`]|[0].Main,Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].GatewayId || Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].NatGatewayId || Routes[?DestinationCidrBlock=='0.0.0.0/0']|[0].VpcEndpointId]" --output text 2>/dev/null || true)
            fi

            OVERWRITE_ROUTES=true
            if [[ ${#rt_list[@]} -gt 0 ]]; then
                echo ""
                echo "${CYAN}Discovered Route Tables in ${AWS_VPC}:${RESET}"
                for idx in "${!rt_list[@]}"; do
                    echo "  [$((idx+1))] ${rt_list[$idx]}"
                done
                read -r -p "Select route table number(s) to steer to ZTGW (comma-separated) [1]: " rt_choice
                rt_choice=${rt_choice:-1}
                selected_rts=()
                IFS=',' read -ra ADDR <<< "$rt_choice"
                for r_sel in "${ADDR[@]}"; do
                    r_sel=$(echo "$r_sel" | tr -d ' ')
                    if [[ "$r_sel" =~ ^[0-9]+$ ]] && [ "$r_sel" -le "${#rt_ids[@]}" ] && [ "$r_sel" -gt 0 ]; then
                        cur_rt="${rt_ids[$((r_sel-1))]}"
                        cur_def="${rt_default_targets[$((r_sel-1))]}"
                        if [[ -n "$cur_def" && "$cur_def" != "None" ]]; then
                            echo "${YELLOW}⚠ Notice: Route table '${cur_rt}' already has a 0.0.0.0/0 route pointing to '${cur_def}'.${RESET}"
                            read -r -p "Overwrite/replace the existing 0.0.0.0/0 route in '${cur_rt}' to steer traffic through ZTGW? (y/n) [y]: " confirm_ovw
                            confirm_ovw=${confirm_ovw:-y}
                            if [[ ! "$confirm_ovw" =~ ^[Yy] ]]; then
                                OVERWRITE_ROUTES=false
                                echo "${YELLOW}Skipping route overwrite.${RESET}"
                            fi
                        fi
                        selected_rts+=("\"${cur_rt}\"")
                    elif [[ -n "$r_sel" ]]; then
                        selected_rts+=("\"${r_sel}\"")
                    fi
                done
                AWS_RTS="[$(IFS=, ; echo "${selected_rts[*]}")]"
            else
                echo "${YELLOW}ℹ Route table discovery unavailable. Defaulting to manual input.${RESET}"
                read -r -p "Workload Route Table ID to steer: " AWS_RT
                AWS_RTS="[\"${AWS_RT}\"]"
            fi
            echo "${GREEN}✓ Using Route Tables: ${AWS_RTS}${RESET}"

            AWS_CONSUMER_VARS="customer_vpc_id         = \"${AWS_VPC}\"
endpoint_subnet_ids     = ${AWS_SUBNETS}
workload_route_table_ids = ${AWS_RTS}
overwrite_existing_routes = ${OVERWRITE_ROUTES}"
        fi

        target_tf_az_list=()
        if command -v aws &>/dev/null; then
            while IFS= read -r zid; do
                [[ -n "$zid" ]] && target_tf_az_list+=("\"$zid\"")
            done < <(aws ec2 describe-availability-zones --region "$AWS_REGION" --query "AvailabilityZones[?ends_with(ZoneId, '-az1') || ends_with(ZoneId, '-az2')].ZoneId" --output text 2>/dev/null | tr '\t' '\n' || true)
        fi
        if [[ ${#target_tf_az_list[@]} -ge 2 ]]; then
            TARGET_TF_AZS="[$(IFS=, ; echo "${target_tf_az_list[*]}")]"
        else
            pfx=$(echo "${AWS_REGION}" | tr -d '-' | cut -c 1-4)
            TARGET_TF_AZS="[\"${pfx}-az1\", \"${pfx}-az2\"]"
        fi

        cat <<EOF > "$TFVARS"
# Generated by ./zsec (Pure Bash)
aws_region              = "${AWS_REGION}"
customer_aws_account_id = "${AWS_ACCOUNT}"
deploy_ztgw             = ${DEPLOY_ZTGW}
deploy_consumer         = ${DEPLOY_CONSUMER}
insecure_skip_verify    = ${INSECURE_VERIFY}

gateway_name            = "${ZTGW_NAME}"
location_name           = "Unified-AWS-${AWS_REGION}"
availability_zones      = ${TARGET_TF_AZS}

client_id               = "${CLIENT_ID}"
client_secret           = "${CLIENT_SECRET}"
vanity_domain           = "${VANITY}"
cloud                   = "${CLOUD_ENV}"

$(if [[ -n "$EXISTING_EP" ]]; then echo "endpoint_service_name = \"${EXISTING_EP}\""; fi)

${AWS_CONSUMER_VARS}
EOF
        chmod 600 "$TFVARS"
    fi

    # Save to .zsecrc cache
    cat <<EOF > ./.zsecrc
TARGET_CLOUD="${TARGET_CLOUD}"
EXAMPLE_DIR="${EXAMPLE_DIR}"
DEPLOY_ZTGW="${DEPLOY_ZTGW}"
DEPLOY_CONSUMER="${DEPLOY_CONSUMER}"
INSECURE_VERIFY="${INSECURE_VERIFY}"
SELECTED_AWS_PROFILE="${SELECTED_AWS_PROFILE}"
AWS_ACCESS_KEY="${AWS_ACCESS_KEY}"
AWS_SECRET_KEY="${AWS_SECRET_KEY}"
AWS_SESSION_TOKEN="${AWS_SESSION_TOKEN}"
EOF
    chmod 600 ./.zsecrc
    echo ""
    echo "${GREEN}✓ Configuration saved:${RESET} ${TFVARS}"
    echo "Setup complete! You can now run:"
    echo "  ${CYAN}./zsec plan${RESET} or ${CYAN}./zsec up${RESET}"
    echo ""
    if [[ "$oper" == "configure" ]]; then
        exit 0
    fi
fi

# Load active configuration cache if present
if [[ -f ./.zsecrc ]]; then
    # shellcheck source=/dev/null
    source ./.zsecrc
fi

TARGET_CLOUD=${TARGET_CLOUD:-gcp}
# Allow command-line platform override (e.g. ./zsec plan aws, ./zsec destroy gcp)
if [[ "$2" == "aws" || "$2" == "gcp" ]]; then
    TARGET_CLOUD="$2"
fi

if [[ "$TARGET_CLOUD" == "aws" ]]; then
    EXAMPLE_DIR="${DIR}/examples/aws/end-to-end"
    if [[ -n "$AWS_ACCESS_KEY" ]]; then
        export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY"
        export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_KEY"
        [[ -n "$AWS_SESSION_TOKEN" ]] && export AWS_SESSION_TOKEN="$AWS_SESSION_TOKEN"
    elif [[ -n "$SELECTED_AWS_PROFILE" && -z "$AWS_PROFILE" ]]; then
        export AWS_PROFILE="$SELECTED_AWS_PROFILE"
    fi
else
    EXAMPLE_DIR="${DIR}/examples/gcp/end-to-end"
fi

if [[ "$INSECURE_VERIFY" == "true" ]]; then
    export INSECURE_SKIP_VERIFY=true
fi

# ---------------------------------------------------------------------------
# Execute Operation
# ---------------------------------------------------------------------------
echo "${CYAN}Target Platform:${RESET} ${TARGET_CLOUD^^} (${EXAMPLE_DIR})"

# Preflight AWS Auth Check: Ensure SSO session is active before running any Terraform operation
if [[ "$TARGET_CLOUD" == "aws" && -n "$SELECTED_AWS_PROFILE" && -z "$AWS_ACCESS_KEY" ]]; then
    target_prof="${SELECTED_AWS_PROFILE:-$AWS_PROFILE}"
    target_prof="${target_prof:-default}"
    if command -v aws &>/dev/null; then
        if ! aws sts get-caller-identity --profile "$target_prof" &>/dev/null; then
            echo ""
            echo "${YELLOW}⚠ AWS SSO session for profile '${target_prof}' is expired or unauthorized.${RESET}"
            read -r -p "Run 'aws sso login --profile ${target_prof}' now? (y/n) [y]: " confirm_sso
            confirm_sso=${confirm_sso:-y}
            if [[ "$confirm_sso" =~ ^[Yy] ]]; then
                echo "${CYAN}--> Running 'aws sso login --profile ${target_prof}'...${RESET}"
                aws sso login --profile "${target_prof}"
                if aws sts get-caller-identity --profile "$target_prof" &>/dev/null; then
                    echo "${GREEN}✓ Successfully authenticated via AWS SSO.${RESET}\n"
                else
                    echo "${RED}✗ Authentication failed after login attempt.${RESET}\n"
                fi
            fi
        fi
        # Export live STS credentials so Terraform Go SDK never fails on SSO cache bugs
        eval "$(aws configure export-credentials --profile "$target_prof" --format env 2>/dev/null || true)"
        unset AWS_PROFILE
    fi
fi

case "$oper" in
    plan)
        echo "Running terraform plan..."
        terraform -chdir="${EXAMPLE_DIR}" plan
        ;;
    up|apply)
        # Pre-apply check: Check for pending tenant edits (Governance protection)
        if command -v python3 &>/dev/null && [[ -f "${EXAMPLE_DIR}/terraform.tfvars" ]]; then
            act_status=0
            python3 -c '
import os, sys, json, ssl, urllib.request, urllib.parse

tfvars = "'"${EXAMPLE_DIR}"'/terraform.tfvars"
c_id, c_secret, vanity, cloud = "", "", "", "zscaler"
with open(tfvars) as f:
    for line in f:
        line = line.strip()
        if line.startswith("client_id") and "=" in line: c_id = line.split("=",1)[1].strip().strip("\"")
        elif line.startswith("client_secret") and "=" in line: c_secret = line.split("=",1)[1].strip().strip("\"")
        elif line.startswith("vanity_domain") and "=" in line: vanity = line.split("=",1)[1].strip().strip("\"")
        elif line.startswith("cloud") and "=" in line: cloud = line.split("=",1)[1].strip().strip("\"")

if not (c_id and c_secret and vanity):
    sys.exit(0)

login_domain_map = {"zscalerbeta": "zsloginbeta.net", "zscalerthree": "zsloginthree.net", "zscalerone": "zsloginone.net", "zscalertwo": "zslogintwo.net"}
login_domain = login_domain_map.get(cloud.lower(), "zslogin.net")
token_url = f"https://{vanity}.{login_domain}/oauth2/v1/token"
base_url = f"https://connector.{cloud.lower()}.net/api/v1"

ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

data = urllib.parse.urlencode({"grant_type": "client_credentials", "client_id": c_id, "client_secret": c_secret}).encode()
req = urllib.request.Request(token_url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded"}, method="POST")
try:
    with urllib.request.urlopen(req, context=ctx, timeout=10) as r:
        token = json.loads(r.read().decode()).get("access_token")
    if not token: sys.exit(0)
    req_chk = urllib.request.Request(f"{base_url}/ecAdminActivateStatus", headers={"Authorization": f"Bearer {token}", "User-Agent": "Zscaler-ZTGW-CLI/2.0"})
    with urllib.request.urlopen(req_chk, context=ctx, timeout=10) as r_chk:
        chk_data = json.loads(r_chk.read().decode())
        if chk_data.get("orgEditStatus") == "EDITS_PRESENT":
            admin_map = chk_data.get("adminStatusMap", {})
            print("\n" + "=" * 70)
            print("\033[1;33m⚠ NOTICE: Pending unactivated draft changes detected in Zscaler tenant!\033[0m")
            if admin_map:
                print("  Active administrator sessions with draft edits:")
                for adm, st in admin_map.items():
                    print(f"    • {adm} ({st})")
            print("=" * 70)
            ans = input("Do you want to activate all pending tenant changes now? (y/n) [n]: ").strip().lower()
            if ans in ("y", "yes"):
                req_act = urllib.request.Request(f"{base_url}/ecAdminActivateStatus/forcedActivate", data=b"{}", headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "Zscaler-ZTGW-CLI/2.0"}, method="PUT")
                with urllib.request.urlopen(req_act, context=ctx, timeout=10):
                    print("\033[1;32m✓ Cloud tenant changes activated successfully.\033[0m\n")
                    sys.exit(0)
            else:
                print("\n\033[1;31mApply cancelled.\033[0m Please review and activate (or discard) pending changes in the Zscaler Admin Portal before proceeding.\n")
                sys.exit(2)
except Exception:
    pass
' || act_status=$?
            if [[ $act_status -eq 2 ]]; then
                exit 0
            fi
        fi

        echo "Running terraform apply..."
        terraform -chdir="${EXAMPLE_DIR}" apply -auto-approve
        echo ""
        echo "${GREEN}============================================================${RESET}"
        echo "${GREEN}  ZTGW Deployment Complete!${RESET}"
        echo "${GREEN}============================================================${RESET}"
        terraform -chdir="${EXAMPLE_DIR}" output
        ;;
    destroy)
        echo ""
        echo "${BOLD}Teardown Scope for ${TARGET_CLOUD^^}:${RESET}"
        echo "  [1] Full Teardown — Destroy cloud consumer VPC plumbing AND deprovision ZTGW in Zscaler"
        echo "  [2] Consumer Only — Disconnect cloud VPC endpoints/routes (keep ZTGW active in Zscaler)"
        echo "  [3] Cancel"
        read -r -p "Enter selection (1, 2, or 3) [1]: " scope_sel
        scope_sel=${scope_sel:-1}
        if [[ "$scope_sel" == "3" || "$scope_sel" == "c" || "$scope_sel" == "cancel" ]]; then
            echo "Teardown cancelled."
            exit 0
        elif [[ "$scope_sel" == "2" ]]; then
            consumer_module="module.gwlb_consumer"
            [[ "$TARGET_CLOUD" == "gcp" ]] && consumer_module="module.nsi_consumer"
            echo ""
            echo "${CYAN}--> Tearing down consumer plumbing only (${consumer_module})...${RESET}"
            terraform -chdir="${EXAMPLE_DIR}" destroy -target "${consumer_module}" -auto-approve
            echo ""
            echo "${GREEN}✓ Consumer plumbing disconnected. ZTGW in Zscaler remains active.${RESET}"
            exit 0
        fi

        while true; do
            read -r -p "${RED}${BOLD}Are you sure you want to completely destroy all ${TARGET_CLOUD^^} ZTGW and cloud resources? (yes/no): ${RESET}" confirm
            case $confirm in
                yes|y) break ;;
                no|n) echo "Destroy cancelled."; exit 0 ;;
                *) echo "Please enter yes or no." ;;
            esac
        done
        echo "Running terraform destroy..."
        terraform -chdir="${EXAMPLE_DIR}" destroy -auto-approve
        echo ""
        echo "${GREEN}Teardown complete.${RESET}"
        ;;
    output)
        terraform -chdir="${EXAMPLE_DIR}" output
        ;;
esac
