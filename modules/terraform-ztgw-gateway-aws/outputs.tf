# -----------------------------------------------------------------------------
# modules/gateway — outputs
# -----------------------------------------------------------------------------

output "endpoint_service_name" {
  description = "The target connection URI generated by Zscaler (IDG URI for GCP, GWLB Endpoint Service name for AWS). Directly consumed by consumer modules."
  value       = ztc_zero_trust_gateway.this.endpoint_service_name
}

output "intercept_deployment_group" {
  description = "Alias for endpoint_service_name on GCP (Intercept Deployment Group URI)."
  value       = ztc_zero_trust_gateway.this.intercept_deployment_group
}

output "gateway_id" {
  description = "The Cloud-assigned ZTGW Gateway ID (e.g. 24110972)."
  value       = ztc_zero_trust_gateway.this.gateway_id
}

output "gateway_name" {
  description = "The configured ZTGW name."
  value       = ztc_zero_trust_gateway.this.name
}

output "health_status" {
  description = "Current reported health status of the ZTGW (HEALTHY)."
  value       = ztc_zero_trust_gateway.this.health_status
}

output "platform" {
  description = "The platform deployed (GCP or AWS)."
  value       = local.platform
}
