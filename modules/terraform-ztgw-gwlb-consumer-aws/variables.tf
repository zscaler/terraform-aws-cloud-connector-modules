# -----------------------------------------------------------------------------
# modules/consumer-aws/gwlb-consumer — inputs
# -----------------------------------------------------------------------------

variable "vpc_id" {
  description = "The customer VPC ID to connect to the ZTGW Gateway Load Balancer."
  type        = string
}

variable "endpoint_service_name" {
  description = "The AWS VPC Endpoint Service name generated by Zscaler (e.g. com.amazonaws.vpce.us-west-2.vpce-svc-0123456789abcdef0)."
  type        = string
}

variable "endpoint_subnet_ids" {
  description = "List of dedicated endpoint subnet IDs where the GWLB endpoint network interfaces will be created (minimum 1 per AZ)."
  type        = list(string)
}

variable "workload_route_table_ids" {
  description = "List of Route Table IDs associated with workload subnets whose traffic should be steered to the ZTGW."
  type        = list(string)
  default     = []
}

variable "intercept_cidr_block" {
  description = "Destination CIDR block to route to ZTGW (default 0.0.0.0/0 for full egress inspection)."
  type        = string
  default     = "0.0.0.0/0"
}

variable "deploy_key" {
  description = "Prefix for tagging customer-side AWS resources (e.g. ztgw-consumer)."
  type        = string
  default     = "ztgw-consumer"
}

variable "tags" {
  description = "Optional additional tags to assign to all created AWS resources."
  type        = map(string)
  default     = {}
}

variable "overwrite_existing_routes" {
  description = "Whether to automatically overwrite/replace existing conflicting routes (e.g. 0.0.0.0/0 to IGW/NAT) in the specified workload route tables."
  type        = bool
  default     = true
}

